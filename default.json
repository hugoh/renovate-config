{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": false,
  "extends": [
    ":automergeAll",
    "config:best-practices",
    "github>hugoh/hk-config//renovate.json",
    "schedule:monthly",
    ":maintainLockFilesMonthly",
    "local>hugoh/renovate-config//presets/vulnerability-alerts",
    "local>hugoh/renovate-config//presets/major-updates-ungrouped",
    "local>hugoh/renovate-config//presets/npm-renovate-debounce",
    "local>hugoh/renovate-config//presets/node-lts"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchManagers": ["!github-actions"],
      "groupName": "non-major updates"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions updates"
    },
    {
      "description": "First-party reusable workflows and composite actions: a bump only reaches consumers once a new tag is cut, so propagate within a day (not the monthly cadence) and automerge. Restricted to the repos that own these workflows/actions.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "hugoh/cog-bump",
        "hugoh/digest-action",
        "hugoh/gh-workflows",
        "hugoh/go-tools",
        "hugoh/spoon-tools"
      ],
      "matchRepositories": [
        "hugoh/cog-bump",
        "hugoh/digest-action",
        "hugoh/gh-workflows",
        "hugoh/go-tools",
        "hugoh/spoon-tools"
      ],
      "schedule": ["at any time"],
      "minimumReleaseAge": "1 day",
      "automerge": true
    }
  ]
}
