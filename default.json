{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":automergeAll",
    ":automergeBranch",
    "config:best-practices",
    "github>hugoh/hk-config//renovate.json",
    "schedule:monthly",
    ":maintainLockFilesMonthly",
    "local>hugoh/renovate-config//presets/vulnerability-alerts",
    "local>hugoh/renovate-config//presets/major-updates-ungrouped",
    "local>hugoh/renovate-config//presets/npm-renovate-debounce",
    "local>hugoh/renovate-config//presets/node-lts"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchManagers": ["!github-actions"],
      "groupName": "non-major updates"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions updates"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["hugoh/gh-workflows"],
      "extends": ["local>hugoh/renovate-config//presets/chain-debounce"]
    }
  ]
}
