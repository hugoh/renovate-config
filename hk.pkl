amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v2.0.0/hk-config@2.0.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.renovate
    ["renovate_config_validator"] = (Base.renovate["renovate_config_validator"]) {
        glob = List("default.json", ".renovaterc.json", "presets/*.json")
    }
    // The hk toolchain group must stay below the generic minor/patch grouping
    // rules in default.json (README: "Rule order matters"); this evaluates the
    // rules with Renovate's own matcher and fails if the group is lost.
    ["hk-grouping"] {
        glob = List("default.json", "scripts/check-hk-grouping.mjs")
        check = "node scripts/check-hk-grouping.mjs"
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        stash = "git"
    }
    ["pre-push"] {
        steps = linters
    }
}
