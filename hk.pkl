amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.0/hk-config@3.1.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.renovate
    ["renovate_config_validator"] = (Base.renovate["renovate_config_validator"]) {
        glob = List("default.json", ".renovaterc.json", "presets/*.json")
    }
    // The renovate CLI group must stay below the generic grouping
    // rules in default.json (README: "Rule order matters"); this evaluates the
    // rules with Renovate's own matcher and fails if the groups, soak,
    // schedule or automerge policy is lost.
    ["package-rules"] {
        glob = List("default.json", "presets/*.json", "scripts/check-package-rules.mjs")
        check = "node scripts/check-package-rules.mjs"
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        stash = "git"
    }
    ["pre-push"] {
        steps = linters
    }
}
