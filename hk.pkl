amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.0/hk-config@3.1.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.renovate
    ["renovate_config_validator"] = (Base.renovate["renovate_config_validator"]) {
        glob = List("default.json", ".renovaterc.json", "presets/*.json")
    }
    // The biome toolchain group must stay below the generic minor/patch
    // grouping rules in default.json (README: "Rule order matters"); this
    // evaluates the rules with Renovate's own matcher and fails if the group,
    // soak or schedule policy is lost. It also reads hk-config's stepTools, so
    // an hk-config bump in hk.pkl re-runs it and fails on an unclassified tool.
    ["package-rules"] {
        glob = List("default.json", "presets/*.json", "scripts/check-package-rules.mjs", "hk.pkl")
        check = "node scripts/check-package-rules.mjs"
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        stash = "git"
    }
    ["pre-push"] {
        steps = linters
    }
}
